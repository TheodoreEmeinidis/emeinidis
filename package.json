{
  "name": "emeinidis-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Website and lightweight Node.js backend for Eminidis Construction.",
  "scripts": {
    "build": "node scripts/generate-english-pages.mjs && node scripts/build-static.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node scripts/init-db.js"
  },
  "devDependencies": {
    "wrangler": "latest"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
